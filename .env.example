# Server
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/capstone_db"

# Redis
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="your_meili_master_key"

# JWT
JWT_SECRET="change_this_jwt_secret_in_production_min_32_chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_SECRET="change_this_refresh_secret_in_production_min_32_chars"
JWT_REFRESH_EXPIRES="7d"

# Client
VITE_API_URL="http://localhost:3001"

# File Upload
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_VIDEO_MB=50

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# OAuth (fill when ready)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/oauth/google/callback
